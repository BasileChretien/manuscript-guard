{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-guard.org/schemas/data-profile/1",
  "title": "manuscript-guard data profile",
  "description": "What the author's script wrote of a file of the vault with `em.profile` (`em$profile` in R), under `vault run`, at profiles/data/<name>.profile.json, and what a person released: for each column its type, its missing values, and its levels or the centiles of its values, each count below the custodian's minimum held back. `vault synthesize` draws the synthetic copy from it and from nothing else.",
  "type": "object",
  "required": ["schema", "name", "dataset", "minimum_cell_count", "rows", "file", "columns"],
  "additionalProperties": false,
  "$defs": {
    "count": {
      "description": "A count: itself, held back behind the custodian's minimum (\"<5\"), or null where it is held back beside another count that the total would give away.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^<[1-9][0-9]*$" },
        { "type": "null" }
      ]
    },
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "centiles": {
      "type": "object",
      "propertyNames": { "enum": ["5", "10", "25", "50", "75", "90", "95"] }
    }
  },
  "properties": {
    "schema": { "const": "manuscript-guard/data-profile/1" },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!(.*/)?[.][.]?(/|$))[^\\\\:]*$",
      "description": "The file's label in the vault, and of its synthetic copy in data/synthetic/."
    },
    "dataset": {
      "type": ["string", "null"],
      "description": "The data dictionary's dataset the table is, as em.profile was given it; null for none."
    },
    "minimum_cell_count": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "description": "The table's rows; a table of fewer than the minimum is not profiled."
    },
    "file": {
      "type": "object",
      "required": ["format", "delimiter", "decimal", "encoding", "quoting", "newline", "bom"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "description": "The file's extension, in lower case." },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "decimal": { "enum": [".", ","] },
        "encoding": { "type": "string", "minLength": 1 },
        "quoting": { "enum": ["minimal", "all"] },
        "newline": { "enum": ["\n", "\r\n"] },
        "bom": { "type": "boolean", "description": "Whether the file opens with a byte-order mark." }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "typed_by", "kind", "missing"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "enum": ["binary", "categorical", "ordinal", "continuous", "count", "date",
                     "datetime", "time", "text", "identifier"]
          },
          "typed_by": { "enum": ["dictionary", "values"] },
          "kind": { "enum": ["levels", "number", "date", "time", "withheld"] },
          "format": { "type": "string" },
          "missing": { "$ref": "#/$defs/count" },
          "missing_share": { "$ref": "#/$defs/share" },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "count"],
              "additionalProperties": false,
              "properties": {
                "level": { "type": "string" },
                "count": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
              }
            }
          },
          "other": {
            "type": "object",
            "required": ["levels", "count"],
            "additionalProperties": false,
            "properties": {
              "levels": {
                "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }],
                "description": "How many levels are folded; said only beside a count printed that is a whole number of m - 1 and where the number is neither the count nor the count over m - 1, else null."
              },
              "count": { "$ref": "#/$defs/count" }
            }
          },
          "unread": { "$ref": "#/$defs/count" },
          "n": { "$ref": "#/$defs/count" },
          "mean": { "type": "number" },
          "sd": { "type": "number", "minimum": 0 },
          "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
          "centiles": { "$ref": "#/$defs/centiles" },
          "pattern": { "type": "string", "minLength": 1 },
          "held": {
            "type": "string",
            "description": "Why a column's counts are withheld, its missing values with them: a reader would work a count out of them, whatever one count held beside it."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "levels" } } },
            "then": {
              "required": ["levels"],
              "properties": { "centiles": false, "n": false, "pattern": false }
            }
          },
          {
            "if": { "properties": { "kind": { "enum": ["number", "date", "time"] } } },
            "then": {
              "required": ["unread", "n", "centiles"],
              "properties": { "levels": false, "other": false, "pattern": false },
              "if": { "properties": { "kind": { "const": "number" } } },
              "then": {
                "properties": { "centiles": { "additionalProperties": { "type": "number" } } }
              },
              "else": {
                "properties": {
                  "centiles": {
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^([0-9]{4}-[0-9]{2}|[0-9]{2}:00)$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "withheld" } } },
            "then": {
              "properties": { "levels": false, "other": false, "centiles": false, "n": false }
            }
          }
        ]
      }
    }
  }
}
