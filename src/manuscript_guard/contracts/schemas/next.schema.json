{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-guard.org/schemas/next/1",
  "title": "manuscript-guard next --json",
  "description": "What `manuscript-guard next --json` prints: where the project stands and what to do, in order. A field added keeps the schema at /1; a field renamed or removed, or a value added to a fixed list, makes it /2. Rule ids are stable. docs/next.md describes each field.",
  "type": "object",
  "required": ["schema", "tool_version", "root", "project", "stage", "counts", "checker", "notes", "actions"],
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "stage": { "enum": ["design", "analysis", "drafting", "internal-review", "submission"] },
    "who": {
      "description": "agent: the agent may run it; author: the author runs it, or decides it; ask-author: the agent runs it only after the author says yes to that command.",
      "enum": ["agent", "author", "ask-author"]
    },
    "argv": {
      "description": "The command's words after the program's name. A word written <NAME> is a placeholder for one word, and <NAME...> for one or more, which its option's `placeholders` explains.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "levels": {
      "type": "object",
      "required": ["fail", "warn", "info"],
      "additionalProperties": false,
      "properties": {
        "fail": { "$ref": "#/$defs/count" },
        "warn": { "$ref": "#/$defs/count" },
        "info": { "$ref": "#/$defs/count" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["code", "path", "line", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/text" },
        "path": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "message": { "type": "string" }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "label", "effect", "command", "argv", "placeholders", "who"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "effect": { "$ref": "#/$defs/text" },
        "command": { "$ref": "#/$defs/text" },
        "argv": { "$ref": "#/$defs/argv" },
        "placeholders": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_]+$" },
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "who": { "$ref": "#/$defs/who" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["question", "recommended", "options"],
      "additionalProperties": false,
      "properties": {
        "question": { "$ref": "#/$defs/text" },
        "recommended": { "type": ["string", "null"] },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "rule", "tier", "title", "why", "codes", "count", "skill", "who",
                   "command", "argv", "findings", "choice"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "rule": {
          "enum": ["cannot-check", "start", "stale-results", "plan", "choose-journal",
                   "choose-english", "choose-guideline", "choose-study-type", "provenance",
                   "failures", "co-author-checks", "warnings", "advance", "optional"]
        },
        "tier": { "type": "integer", "minimum": 0, "maximum": 10 },
        "title": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "codes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "count": { "$ref": "#/$defs/count" },
        "skill": { "type": ["string", "null"] },
        "who": { "$ref": "#/$defs/who" },
        "command": { "type": ["string", "null"] },
        "argv": { "oneOf": [{ "$ref": "#/$defs/argv" }, { "type": "null" }] },
        "findings": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/finding" } },
        "choice": { "oneOf": [{ "$ref": "#/$defs/choice" }, { "type": "null" }] }
      }
    }
  },
  "properties": {
    "schema": { "const": "manuscript-guard/next/1" },
    "tool_version": { "$ref": "#/$defs/text" },
    "root": { "$ref": "#/$defs/text" },
    "project": {
      "type": "object",
      "required": ["kind", "format", "error"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["none", "missing", "authors-only", "unreadable", "project"] },
        "format": { "enum": ["markdown", "latex", null] },
        "error": { "type": ["string", "null"] }
      }
    },
    "stage": {
      "type": "object",
      "required": ["current", "next", "declared", "description"],
      "additionalProperties": false,
      "properties": {
        "current": {
          "description": "The stage decided at: --stage, else the one paper.yaml declares.",
          "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }]
        },
        "declared": {
          "description": "The stage paper.yaml declares (drafting where it declares none). A move is offered only from this one, and only forward.",
          "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }]
        },
        "next": { "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }] },
        "description": { "type": ["string", "null"] }
      }
    },
    "counts": {
      "type": "object",
      "required": ["fail", "warn", "info", "by_gate", "deferred"],
      "additionalProperties": false,
      "properties": {
        "fail": { "$ref": "#/$defs/count" },
        "warn": { "$ref": "#/$defs/count" },
        "info": { "$ref": "#/$defs/count" },
        "by_gate": {
          "type": "object",
          "required": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9", "G10", "G11",
                       "G12", "G13", "G14", "G15", "G16", "BUILD"],
          "propertyNames": { "pattern": "^[A-Za-z0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/levels" }
        },
        "deferred": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/stage" },
          "additionalProperties": { "$ref": "#/$defs/count" }
        }
      }
    },
    "checker": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["items", "outstanding", "stale", "disagreements"],
          "additionalProperties": false,
          "properties": {
            "items": { "$ref": "#/$defs/count" },
            "outstanding": { "$ref": "#/$defs/count" },
            "stale": { "$ref": "#/$defs/count" },
            "disagreements": { "$ref": "#/$defs/count" }
          }
        }
      ]
    },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
  }
}
