# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# setuptools output, at the repository root only. NOT a bare `build/`: that matches any
# directory of that name at any depth, and it silently excluded the whole of
# src/manuscript_guard/build/ from the repository. Everything passed locally, where the
# files exist on disk, and CI failed on every platform with ModuleNotFoundError.
/build/

# R
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/

# Manuscript build artefacts (always regenerated; never a source of truth). Named
# explicitly for the same reason as above.
example/build/
*.docx
*.pdf
!profiles/**/*.pdf

# Official guideline documents, downloaded for transcription. Not committed: each carries
# its own licence, and several are CC BY-NC-SA, which cannot be redistributed from an MIT
# repository. The transcribed YAML records the source URL and licence so anyone can fetch
# the original and check the transcription.
profiles/reporting/sources/

# Generated checklist profiles. Produced locally by `manuscript-guard transcribe` from your
# own copy of each official document, so everyone gets an identical profile without the
# repository redistributing text it may not have the right to. The recipes ARE committed.
profiles/reporting/*.yaml

# OS
.DS_Store
Thumbs.db

# pytest-cov output
.coverage
.coverage.*
htmlcov/
