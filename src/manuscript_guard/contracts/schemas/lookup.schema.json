{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-guard.org/schemas/lookup/1",
  "title": "manuscript-guard lookup record",
  "description": "What the registries said of one cited reference, on one day: of its DOI and PMID, or, for a reference with neither, what a search by its title found. `manuscript-guard lookup` writes it to literature/lookups/<citekey>.yaml; G7 reads it offline. It holds what was answered, never the requests: no URL, no key, no contact address. Version 2 keeps each work's authors, and the searches; version 3 keeps PubMed's links to later works, the PMID PubMed gives a DOI cited without one (`pubmed_by_doi`), and Crossref's dates as far as it gives them. A record of an older version is read as before, and the next `lookup` asks again for it.",
  "type": "object",
  "required": ["schema", "citekey", "looked_up_on", "entry_sha256", "identifiers", "sources", "answers_sha256"],
  "additionalProperties": false,
  "$defs": {
    "status": { "enum": ["found", "absent", "unresolvable"] },
    "year": { "type": "integer", "minimum": 1000, "maximum": 9999 },
    "text": { "type": "string", "minLength": 1 },
    "notice": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/text" },
        "doi": { "$ref": "#/$defs/text" },
        "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}){0,2}$" },
        "source": { "$ref": "#/$defs/text" }
      }
    },
    "unresolvable": {
      "if": { "properties": { "status": { "const": "unresolvable" } } },
      "then": { "required": ["why"] }
    },
    "pmid": { "type": "string", "pattern": "^\\d{1,9}$" },
    "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}){0,2}$" },
    "dates": {
      "description": "Crossref's dates as far as it gives them: a year, a month or a day.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "print": { "$ref": "#/$defs/date" },
        "online": { "$ref": "#/$defs/date" },
        "issued": { "$ref": "#/$defs/date" },
        "posted": { "$ref": "#/$defs/date" }
      }
    },
    "links": {
      "description": "PubMed's links from the work to later ones, from ESummary's `references`: each its type, the PMID it points to and PubMed's reference to that work.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["Update in", "Erratum in", "Comment in", "Expression of concern in", "Retraction in"] },
          "pmid": { "$ref": "#/$defs/pmid" },
          "reference": { "$ref": "#/$defs/text" }
        }
      }
    },
    "authors": {
      "description": "A work's authors as the registry lists them, in its order: a person by family and given names, a group by its name.",
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "family": { "$ref": "#/$defs/text" },
          "given": { "$ref": "#/$defs/text" },
          "group": { "$ref": "#/$defs/text" }
        }
      }
    },
    "years": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "print": { "$ref": "#/$defs/year" },
        "online": { "$ref": "#/$defs/year" },
        "issued": { "$ref": "#/$defs/year" },
        "posted": { "$ref": "#/$defs/year" }
      }
    },
    "crossref_work": {
      "type": "object",
      "required": ["doi"],
      "additionalProperties": false,
      "properties": {
        "doi": { "$ref": "#/$defs/text" },
        "type": { "$ref": "#/$defs/text" },
        "subtype": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "original_title": { "$ref": "#/$defs/text" },
        "container": { "$ref": "#/$defs/text" },
        "years": { "$ref": "#/$defs/years" },
        "dates": { "$ref": "#/$defs/dates" },
        "volume": { "$ref": "#/$defs/text" },
        "page": { "$ref": "#/$defs/text" },
        "article_number": { "$ref": "#/$defs/text" },
        "updated_by": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
        "update_to": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
        "preprint_of": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "authors": { "$ref": "#/$defs/authors" }
      }
    },
    "pubmed_summary": {
      "type": "object",
      "required": ["pmid"],
      "additionalProperties": false,
      "properties": {
        "pmid": { "$ref": "#/$defs/pmid" },
        "title": { "$ref": "#/$defs/text" },
        "year": { "$ref": "#/$defs/year" },
        "doi": { "$ref": "#/$defs/text" },
        "pubtypes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "links": { "$ref": "#/$defs/links" },
        "volume": { "$ref": "#/$defs/text" },
        "pages": { "$ref": "#/$defs/text" },
        "elocation": { "$ref": "#/$defs/text" },
        "journal": { "$ref": "#/$defs/text" },
        "journal_abbreviation": { "$ref": "#/$defs/text" },
        "authors": { "$ref": "#/$defs/authors" }
      }
    },
    "openalex_work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": { "$ref": "#/$defs/text" },
        "pmid": { "$ref": "#/$defs/pmid" },
        "title": { "$ref": "#/$defs/text" },
        "type": { "$ref": "#/$defs/text" },
        "year": { "$ref": "#/$defs/year" },
        "is_retracted": { "type": "boolean" },
        "authors": { "$ref": "#/$defs/authors" }
      }
    },
    "search": {
      "description": "What one registry's search by the cited title answered: `found` where it matched works, `absent` where it matched none. Whether one of them is the cited work is G7's to say.",
      "type": "object",
      "required": ["status"],
      "allOf": [{ "$ref": "#/$defs/unresolvable" }],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "why": { "$ref": "#/$defs/text" },
        "asked": {
          "description": "What was sent, as sent: each search term or query, in order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "count": {
          "description": "How many works the registry matched in all; the candidates are those of its first answers that hold half the cited title's words or more.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema": { "enum": ["manuscript-guard/lookup/1", "manuscript-guard/lookup/2", "manuscript-guard/lookup/3"] },
    "citekey": { "$ref": "#/$defs/text" },
    "looked_up_on": { "type": "string", "format": "date" },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The digest of the references.bib entry that was looked up, its fields as the file writes them. An entry edited since was not the one looked up."
    },
    "answers_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The digest of everything else in the record, written by `lookup`. An answer edited by hand without it changes is reported; one edited by someone who computes it again is not."
    },
    "identifiers": {
      "description": "The DOI and the PMID looked up; none for a reference with neither, which was searched for by its title.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": { "$ref": "#/$defs/text" },
        "pmid": { "type": "string", "pattern": "^\\d{1,9}$" }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "crossref": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [{ "$ref": "#/$defs/unresolvable" }],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "why": { "$ref": "#/$defs/text" },
            "doi": { "$ref": "#/$defs/text" },
            "type": { "$ref": "#/$defs/text" },
            "subtype": { "$ref": "#/$defs/text" },
            "title": { "$ref": "#/$defs/text" },
            "subtitle": { "$ref": "#/$defs/text" },
            "original_title": { "$ref": "#/$defs/text" },
            "container": { "$ref": "#/$defs/text" },
            "years": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "print": { "$ref": "#/$defs/year" },
                "online": { "$ref": "#/$defs/year" },
                "issued": { "$ref": "#/$defs/year" },
                "posted": { "$ref": "#/$defs/year" }
              }
            },
            "dates": { "$ref": "#/$defs/dates" },
            "volume": { "$ref": "#/$defs/text" },
            "page": { "$ref": "#/$defs/text" },
            "article_number": { "$ref": "#/$defs/text" },
            "updated_by": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
            "update_to": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
            "preprint_of": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "authors": { "$ref": "#/$defs/authors" }
          }
        },
        "openalex": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [{ "$ref": "#/$defs/unresolvable" }],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "why": { "$ref": "#/$defs/text" },
            "is_retracted": { "type": "boolean" },
            "title": { "$ref": "#/$defs/text" },
            "type": { "$ref": "#/$defs/text" },
            "year": { "$ref": "#/$defs/year" }
          }
        },
        "datacite": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [{ "$ref": "#/$defs/unresolvable" }],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "why": { "$ref": "#/$defs/text" },
            "title": { "$ref": "#/$defs/text" },
            "type": { "$ref": "#/$defs/text" },
            "year": { "$ref": "#/$defs/year" }
          }
        },
        "doi_org": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [{ "$ref": "#/$defs/unresolvable" }],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "why": { "$ref": "#/$defs/text" }
          }
        },
        "pubmed": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [{ "$ref": "#/$defs/unresolvable" }],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "why": { "$ref": "#/$defs/text" },
            "title": { "$ref": "#/$defs/text" },
            "year": { "$ref": "#/$defs/year" },
            "doi": { "$ref": "#/$defs/text" },
            "pubtypes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "links": { "$ref": "#/$defs/links" },
            "volume": { "$ref": "#/$defs/text" },
            "pages": { "$ref": "#/$defs/text" },
            "elocation": { "$ref": "#/$defs/text" },
            "journal": { "$ref": "#/$defs/text" },
            "journal_abbreviation": { "$ref": "#/$defs/text" },
            "authors": { "$ref": "#/$defs/authors" }
          }
        },
        "pubmed_by_doi": {
          "description": "What PubMed said of the DOI of an entry with no PMID: one exact search in its `[doi]` field, then the summary of the one PMID it gave, kept only where that PMID's record holds the DOI. `absent` where it gave none, `refused` where it gave several or one whose record holds another DOI: none is kept then. Read for publication types and links, never to say whether the entry names the work.",
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "allOf": [
            { "$ref": "#/$defs/unresolvable" },
            { "if": { "properties": { "status": { "const": "refused" } } }, "then": { "required": ["why"] } },
            { "if": { "properties": { "status": { "const": "found" } } }, "then": { "required": ["pmid"] } }
          ],
          "properties": {
            "status": { "enum": ["found", "absent", "refused", "unresolvable"] },
            "why": { "$ref": "#/$defs/text" },
            "count": { "type": "integer", "minimum": 0 },
            "pmid": { "$ref": "#/$defs/pmid" },
            "title": { "$ref": "#/$defs/text" },
            "year": { "$ref": "#/$defs/year" },
            "doi": { "$ref": "#/$defs/text" },
            "pubtypes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "links": { "$ref": "#/$defs/links" },
            "volume": { "$ref": "#/$defs/text" },
            "pages": { "$ref": "#/$defs/text" },
            "elocation": { "$ref": "#/$defs/text" },
            "journal": { "$ref": "#/$defs/text" },
            "journal_abbreviation": { "$ref": "#/$defs/text" },
            "authors": { "$ref": "#/$defs/authors" }
          }
        },
        "pubmed_search": {
          "allOf": [{ "$ref": "#/$defs/search" }],
          "unevaluatedProperties": false,
          "properties": {
            "candidates": { "type": "array", "items": { "$ref": "#/$defs/pubmed_summary" } }
          }
        },
        "crossref_search": {
          "allOf": [{ "$ref": "#/$defs/search" }],
          "unevaluatedProperties": false,
          "properties": {
            "candidates": { "type": "array", "items": { "$ref": "#/$defs/crossref_work" } }
          }
        },
        "openalex_search": {
          "allOf": [{ "$ref": "#/$defs/search" }],
          "unevaluatedProperties": false,
          "properties": {
            "candidates": { "type": "array", "items": { "$ref": "#/$defs/openalex_work" } }
          }
        }
      }
    }
  }
}
