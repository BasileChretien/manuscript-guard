{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-guard.org/schemas/currency/1",
  "title": "manuscript-guard reference currency",
  "description": "literature/currency.yaml: for a sentence of the manuscript and one work it cites, whether the work is still the one to cite. Each entry is matched to the manuscript by the sentence's words, folded as a passage's are, and the citation key. Its decision is the rules' (`by: rules`, from two readings filed with `references --reading`) or a person's, with the reason; a proposed change waits for a person's answer.",
  "type": "object",
  "required": ["schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "manuscript-guard/currency/1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "work": {
      "type": "string",
      "pattern": "^(doi:10\\.[^\\sA-Z]+|pmid:[1-9][0-9]*)$",
      "description": "A work by its DOI, in lower case, or its PMID: doi:10.1000/xyz or pmid:12345."
    },
    "person": { "type": "string", "pattern": "\\S" },
    "entry": {
      "type": "object",
      "required": ["id", "sentence", "citekey"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^c[1-9][0-9]*$", "description": "The entry's own id, which never changes: c1, c2 ..." },
        "sentence": { "type": "string", "pattern": "\\S", "description": "The citing sentence as the manuscript writes it. Its citations, case, line breaks and typography are folded before it is matched." },
        "citekey": { "type": "string", "pattern": "\\S" },
        "question": { "type": "string", "pattern": "\\S", "description": "The claim written as a question (rule F1)." },
        "marked_by": { "$ref": "#/$defs/person" },
        "marked_on": { "type": "string", "format": "date" },
        "decision": { "$ref": "#/$defs/decision" },
        "answer": { "$ref": "#/$defs/answer" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["action", "rules", "by", "decided_on"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["replace", "add", "keep", "uncertain"] },
        "candidate": { "$ref": "#/$defs/work" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[FSRKD][1-9]$" }
        },
        "by": { "$ref": "#/$defs/person", "description": "`rules`, where the rules decided from the readings; else the person who decided, with `why`." },
        "why": { "type": "string", "pattern": "\\S" },
        "decided_on": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["replace", "add"] } } },
          "then": { "required": ["candidate"] }
        },
        {
          "if": { "properties": { "by": { "const": "rules" } } },
          "else": { "required": ["why"] }
        }
      ]
    },
    "answer": {
      "type": "object",
      "required": ["status", "by", "answered_on"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["accepted", "refused"] },
        "by": {
          "$ref": "#/$defs/person",
          "not": { "const": "rules" },
          "description": "The person who answered: never `rules`, which decide and do not answer."
        },
        "why": { "type": "string", "pattern": "\\S" },
        "answered_on": { "type": "string", "format": "date" }
      },
      "if": { "properties": { "status": { "const": "refused" } } },
      "then": { "required": ["why"] }
    }
  }
}
